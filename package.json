{
  "name": "nomination-please",
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node --experimental-strip-types tests/engine.test.ts && node --experimental-strip-types tests/patch08.test.ts && node --experimental-strip-types tests/patch09.test.ts && node --experimental-strip-types tests/patch10.test.ts",
    "simulate": "node --experimental-strip-types tests/simulate.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser.mjs",
    "debug:save": "node --experimental-strip-types scripts/debug-save.ts",
    "test:render": "node tests/render.mjs",
    "simulate:policies": "node --experimental-strip-types tests/balance-policies.ts",
    "test:browser:patch": "node tests/browser08.mjs",
    "test:browser:final": "node tests/browser09.mjs",
    "test:browser:short": "node tests/browser10.mjs"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
